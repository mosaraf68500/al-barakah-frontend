# Public site URL used for sitemap / canonical / OG (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express API. The storefront calls this directly.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# TEMP: Phase 1 only. Legacy Express server (order e-mail / Telegram relay).
# It is down/unreliable: every call is wrapped in try/catch and never blocks a user action.
# Leave unset to skip the calls entirely.
LEGACY_API_URL=

# TEMP: Phase 1 only. Real third-party calls (Telegram/e-mail relay, Facebook CAPI) are OFF by default
# because orders placed in this seed-data app are NOT real orders. Set to "true" only deliberately.
ENABLE_LIVE_INTEGRATIONS=false
# Loads the Facebook Pixel script in the browser (would pollute the production pixel while this is a snapshot app).
NEXT_PUBLIC_ENABLE_FB_PIXEL=false
